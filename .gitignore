# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/scratch

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit secrets)
.env
.env.*
.env*.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.*
!.env.example
!.env.template

# API keys, credentials, & service accounts (NEVER commit)
*.key
*.secret
*.credentials
credentials.json
client_secret*.json
service-account*.json
google-services.json
firebase-*.json
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
*.keystore
*.jks

# Database files & local dumps with sensitive data
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# Supabase CLI local generated files & secrets
.supabase/
supabase/.temp/
supabase/seed.sql.bak

# Generated Chrome extension configuration
public/extension/config.js

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini
