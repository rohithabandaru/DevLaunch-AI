# Supabase Credentials (Public - exposed to browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET - server only, NEVER exposed to browser)
# Required for the Chrome extension authenticated clip flow and extension
# session tokens. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI Credentials (Secret - never exposed to browser)
OPENAI_API_KEY=your-openai-api-key-here

# Chrome extension configuration (deployed production URL + allowed origins)
# The deployed DevLaunch AI URL used to build the extension:
#   DEVLAUNCH_APP_URL=https://your-domain.example  npm run extension:build
# Comma-separated chrome-extension:// origins allowed to call extension APIs
# in production (omit or leave empty to deny all cross-origin extension calls).
ALLOWED_EXTENSION_ORIGINS=

# Razorpay Credentials (Recommended for India - UPI / Cards / Netbanking)
# Checkout only settles in INR. USD pricing on the pricing page is marketing
# copy until a USD processor is configured; /api/razorpay/create-order refuses
# USD rather than silently charging rupees for a plan advertised in dollars.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay webhook signing secret (server only). Required for the billing
# reconciliation path: /api/razorpay/webhook verifies the raw request body with
# this secret and fails CLOSED when it is unset, so leaving it blank means
# payment.captured and refund.processed are never processed.
#
# Razorpay Dashboard > Settings > Webhooks > Add New Webhook
#   URL:      https://yourdomain.example/api/razorpay/webhook
#   Secret:   (set here)
#   Events:   payment.captured, payment.failed, refund.processed
# Then set the same secret in your Vercel environment variables.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# NOTE: Stripe is NOT wired up. The keys below are placeholders and no Stripe
# route exists, so `pk_test_...` can never work. Razorpay is the only live
# payment path. Remove these or implement them before advertising them.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Gmail sync (job tracker "AI Email Sync Engine") — SERVER ONLY.
# The app runs the OAuth authorization-code + PKCE flow itself
# (/api/email/gmail/connect -> Google -> /api/email/gmail/callback), so the
# client secret and the resulting tokens never reach the browser.
#
# From Google Cloud Console > Google Auth Platform > Clients
# (Web application), add this Authorized redirect URI:
#   http://localhost:3000/api/email/gmail/callback
#   https://yourdomain.example/api/email/gmail/callback
# Also enable the Gmail API for the project.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# Optional. The flow is a public client using PKCE, so the code verifier is what
# authenticates the token exchange and a secret is not required. Set this only
# if Google issued your client a secret and rejects a secretless exchange.
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Optional: override the callback URL (defaults to <site-url>/api/email/gmail/callback)
# GOOGLE_OAUTH_REDIRECT_URI=

# Encrypts mailbox OAuth tokens at rest (AES-256-GCM). Generate a random 32-byte
# key; rotating it invalidates existing connections and users must reconnect.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=your-token-encryption-secret-key-32-chars

# Optional tuning for the mailbox scan.
# GMAIL_SYNC_MAX_MESSAGES=50      # cap on messages read per sync (max 50)
# GMAIL_SYNC_DAYS=30              # how far back to scan
# GMAIL_SYNC_QUERY=in:inbox newer_than:30d -category:promotions

# NOTE: Microsoft (Outlook) sync is NOT implemented. The connection server-side
# behind Microsoft Graph does not exist yet, and the UI says so rather than
# pretending to connect.

# Custom SMTP Credentials for Production Auth Emails (e.g. Resend / SendGrid).
# Auth email is currently delivered by Supabase's own SMTP; these are only read
# if you add a custom mailer. They are not referenced by any code today.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_SENDER_NAME="DevLaunch AI"
SMTP_SENDER_EMAIL=noreply@yourdomain.com
