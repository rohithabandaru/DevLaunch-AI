# Supabase Credentials (Public - exposed to browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET - server only, NEVER exposed to browser)
# Required for the Chrome extension authenticated clip flow and extension
# session tokens. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI Credentials (Secret - never exposed to browser)
OPENAI_API_KEY=your-openai-api-key-here

# Chrome extension configuration (deployed production URL + allowed origins)
# The deployed DevLaunch AI URL used to build the extension:
#   DEVLAUNCH_APP_URL=https://your-domain.example  npm run extension:build
# Comma-separated chrome-extension:// origins allowed to call extension APIs
# in production (omit or leave empty to deny all cross-origin extension calls).
ALLOWED_EXTENSION_ORIGINS=

# Stripe Credentials (Optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Credentials (Recommended for India - UPI / Cards / Netbanking)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Job Tracker Email OAuth Integration Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=your-microsoft-oauth-client-secret
EMAIL_ENCRYPTION_KEY=your-token-encryption-secret-key-32-chars
# Custom SMTP Credentials for Production Auth Emails (e.g. Resend / SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_SENDER_NAME="DevLaunch AI"
SMTP_SENDER_EMAIL=noreply@yourdomain.com
